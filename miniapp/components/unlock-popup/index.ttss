/* unlock-popup · Token 取自线稿说明 §一（色值冻结） */
.mm-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(58, 43, 46, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.up__panel {
  width: 606rpx;
  background: #FFF8F0;
  border: 1rpx solid rgba(194, 64, 47, 0.28);
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  text-align: center;
}

.up__dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 26rpx;
}

.up__dot {
  width: 28rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: rgba(185, 175, 166, 0.6);
}

.up__dot--on {
  background: #C2402F;
}

.up__title {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 34rpx;
  color: #3A2B2E;
  letter-spacing: 0.06em;
  margin-bottom: 16rpx;
}

.up__msg {
  font-size: 25rpx;
  line-height: 1.75;
  color: rgba(58, 43, 46, 0.62);
}

.up__slot {
  margin: 28rpx 0;
  height: 264rpx;
  border: 1rpx dashed rgba(194, 64, 47, 0.28);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  color: #B9AFA6;
  position: relative;
}

.up__slot--playing {
  background: #FDF1E5;
}

.up__bar {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 6rpx;
  width: 58%;
  background: #C2402F;
}

.up__close {
  position: absolute;
  right: 16rpx;
  top: 12rpx;
  font-size: 28rpx;
  color: #3A2B2E;
}

.up__spin {
  width: 52rpx;
  height: 52rpx;
  margin: 26rpx auto;
  border: 4rpx solid rgba(194, 64, 47, 0.2);
  border-top-color: #C2402F;
  border-radius: 50%;
  animation: up-rotate 1s linear infinite;
}

@keyframes up-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.mm-btn {
  display: block;
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 29rpx;
  line-height: 92rpx;
  padding: 0;
  margin: 20rpx 0 0 0;
  background: none;
  color: #3A2B2E;
}

.mm-btn--primary {
  background: #C2402F;
  color: #FFF8F0;
  font-weight: 600;
}

.mm-btn--ghost {
  background: transparent;
  border: 1rpx solid rgba(194, 64, 47, 0.55);
  color: #A32E22;
}

.mm-btn--disabled,
.mm-btn[disabled] {
  background: #EFE4D9;
  color: #B9AFA6;
}

.up__warn {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(201, 138, 46, 0.12);
  color: #A9631F;
  font-size: 24rpx;
}

.up__note {
  margin-top: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: rgba(58, 43, 46, 0.62);
}
