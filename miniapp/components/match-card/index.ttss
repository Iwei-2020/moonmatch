/* match-card · Token 取自线稿说明 §一（色值冻结） */
.mm-card {
  background: #FDF1E5;
  border: 1rpx solid rgba(194, 64, 47, 0.28);
  border-radius: 32rpx;
  padding: 32rpx;
}

.mc--unlocked {
  background: rgba(63, 122, 90, 0.06);
  border-color: rgba(63, 122, 90, 0.45);
}

.mc--expired {
  background: #F4ECE4;
  border-style: dashed;
  border-color: rgba(185, 175, 166, 0.75);
}

.mc__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mc__title {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 48rpx;
  letter-spacing: 0.04em;
  color: #3A2B2E;
}

.mc--expired .mc__title {
  color: #7A7069;
}

.mm-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.mm-badge--ok {
  color: #3F7A5A;
  background: rgba(63, 122, 90, 0.1);
  border-color: rgba(63, 122, 90, 0.45);
}

.mc-badge--locked {
  color: #A97A1E;
  background: rgba(217, 164, 65, 0.14);
  border-color: rgba(217, 164, 65, 0.62);
}

.mc-badge--lock {
  color: #7A7069;
  background: rgba(185, 175, 166, 0.16);
  border-color: rgba(185, 175, 166, 0.75);
}

.mc__sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: rgba(58, 43, 46, 0.62);
}

.mc__field {
  margin-top: 24rpx;
}

.mc__act {
  margin-top: 24rpx;
}

.mm-btn {
  display: block;
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 29rpx;
  line-height: 92rpx;
  padding: 0;
  margin: 0;
  background: none;
  color: #3A2B2E;
}

.mm-btn--primary {
  background: #C2402F;
  color: #FFF8F0;
  font-weight: 600;
}

.mc__warn {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(201, 138, 46, 0.12);
  color: #A9631F;
  font-size: 24rpx;
}

.mc__foot {
  margin-top: 22rpx;
}

.mc__link {
  display: inline-block;
  font-size: 24rpx;
  color: rgba(58, 43, 46, 0.62);
  text-decoration: underline;
}
