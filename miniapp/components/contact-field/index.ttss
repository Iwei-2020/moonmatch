/* contact-field · Token 取自线稿说明 §一（色值冻结） */
.cf {
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid rgba(194, 64, 47, 0.28);
  background: #FFFDFA;
}

/* 锁定态：掩码灰 + 描边 */
.cf--locked {
  border-color: rgba(194, 64, 47, 0.28);
  background: #FFFDFA;
}

/* 已解签态：ok 6% 底 + ok 描边 */
.cf--unlocked {
  border-color: rgba(63, 122, 90, 0.45);
  background: rgba(63, 122, 90, 0.06);
}

/* 失效态：灰调虚线 */
.cf--expired {
  border-style: dashed;
  border-color: rgba(185, 175, 166, 0.75);
  background: #F4ECE4;
}

.cf__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mm-mask {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 34rpx;
  letter-spacing: 0.1em;
  color: #B9AFA6;
}

.cf--unlocked .cf__mask {
  color: #3A2B2E;
}

.cf--expired .cf__mask {
  color: #B9AFA6;
  text-decoration: line-through;
}

.cf__icon {
  font-size: 28rpx;
  color: #B9AFA6;
}

.cf__act {
  margin-top: 20rpx;
}

.mm-btn {
  width: 100%;
  height: 56rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 23rpx;
  line-height: 56rpx;
  padding: 0;
  margin: 0;
}

.mm-btn--primary {
  background: #3F7A5A;
  color: #FFF8F0;
  font-weight: 600;
}

.mm-btn[disabled] {
  background: #EFE4D9;
  color: #B9AFA6;
}

.cf__notice {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #A32E22;
  text-align: center;
}

.cf__dead {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #C98A2E;
}
