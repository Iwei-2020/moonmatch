<!-- P-01 首页 · 仅「取一个」「留一个」两个业务入口；取签流程内联于本页浮层 -->
<view class="mm-page home">
  <view class="home__hd">
    <view class="home__brand">
      <view class="home__name">月老办事处</view>
      <view class="home__en">MOONMATCH</view>
    </view>
    <view class="home__corner" bindtap="goLegal">协议</view>
  </view>

  <view class="home__lattice"></view>

  <!-- 主视觉：双光晕 + 一弯月 + 一缕红线 + 星点（纯 CSS 绘制，零素材） -->
  <view class="home__hero">
    <view class="home__halo home__halo--outer"></view>
    <view class="home__halo home__halo--inner"></view>
    <view class="home__moon"></view>
    <view class="home__thread"></view>
    <view class="home__star home__star--a"></view>
    <view class="home__star home__star--b"></view>
  </view>

  <view class="mm-sub home__tagline">{{tagline}}</view>

  <!-- 缘分 / 运气 / 相遇（符号为纯 CSS 图形） -->
  <view class="home__trio">
    <view tt:for="{{trio}}" tt:key="key" class="home__tile">
      <view class="home__glyph home__glyph--{{item.key}}"></view>
      <view class="home__tile-label">{{item.label}}</view>
      <view class="home__tile-text">{{item.text}}</view>
    </view>
  </view>

  <view class="home__state home__state--{{state}}">
    <view class="home__state-row">
      <view class="home__state-text">{{summary}}</view>
      <audit-badge tt:if="{{state !== 'unregistered'}}" status="{{badgeStatus}}" />
    </view>
  </view>

  <view class="home__count">
    <view class="home__count-label">今日剩余缘签</view>
    <view class="home__count-num">{{remain}} 个</view>
  </view>

  <view class="home__cta">
    <button class="mm-btn mm-btn--primary home__btn" bindtap="onTapTake">{{takeBtnText}}</button>
    <button class="mm-btn mm-btn--ghost home__btn" bindtap="onTapKeep">{{keepBtnText}}</button>
  </view>

  <view class="mm-disclaimer home__disclaimer">{{disclaimer}}</view>
</view>

<!-- 内联浮层：留一个（表单）/ 取一个（选男/女签筒 → 看广告 → 展示缘签），均不跳转新页面 -->
<view tt:if="{{overlay}}" class="home__ov" bindtap="closeOverlay">
  <view class="home__ov-panel" catchtap="noop">
    <scroll-view scroll-y class="home__ov-scroll">
      <!-- 留一个：内联留缘签表单 -->
      <block tt:if="{{overlayMode === 'register'}}">
        <profile-form bind:done="onFormDone" />
      </block>

      <!-- 取一个 -->
      <block tt:else>
        <!-- ① 选签筒 -->
        <block tt:if="{{stage === 'pool'}}">
          <view class="home__ov-title">{{poolTitle}}</view>
          <view class="home__pool">
            <view
              tt:for="{{poolOptions}}"
              tt:key="value"
              class="home__pool-btn"
              data-value="{{item.value}}"
              bindtap="onChoosePool"
            >{{item.label}}</view>
          </view>
          <view class="home__ov-note">{{poolNote}}</view>
          <button class="mm-btn mm-btn--ghost home__ov-btn" bindtap="closeOverlay">{{poolCancelText}}</button>
        </block>

        <!-- ② 匹配中 -->
        <block tt:elif="{{stage === 'matching'}}">
          <view class="home__ov-spin"></view>
          <view class="home__ov-text">{{matchingText}}</view>
        </block>

        <!-- ③ 池空 / 达上限 -->
        <block tt:elif="{{stage === 'empty' || stage === 'limit'}}">
          <view class="home__ov-text">{{stage === 'empty' ? emptyText : limitText}}</view>
          <button class="mm-btn mm-btn--ghost home__ov-btn" bindtap="closeOverlay">知道了</button>
        </block>

        <!-- ④ 展示缘签 -->
        <block tt:else>
          <match-card
            card="{{card}}"
            mode="{{cardMode}}"
            bind:unlock="onUnlock"
            bind:report="onCardReport"
          />
          <view class="home__ov-count">今日剩余缘签 {{remain}} 个</view>
          <button class="mm-btn mm-btn--ghost home__ov-btn" bindtap="closeOverlay">收起</button>
        </block>
      </block>
    </scroll-view>
  </view>
</view>

<unlock-popup
  visible="{{popupVisible}}"
  state="{{popupState}}"
  failureText="{{popupFailure}}"
  bind:retry="onPopupRetry"
  bind:close="onPopupClose"
/>
