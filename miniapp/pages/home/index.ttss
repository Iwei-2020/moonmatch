/* P-01 首页 · Token 取自线稿说明 §一（色值冻结） */
.home {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.home__hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.home__name {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 42rpx;
  letter-spacing: 0.14em;
  color: #3A2B2E;
}

.home__en {
  margin-top: 6rpx;
  font-size: 18rpx;
  letter-spacing: 0.32em;
  color: #D9A441;
}

.home__corner {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(194, 64, 47, 0.28);
  background: #FFFDFA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #3A2B2E;
}

.home__lattice {
  height: 1rpx;
  margin: 28rpx 0 20rpx;
  background: rgba(194, 64, 47, 0.28);
}

/* 主视觉：双光晕 + 月牙 + 红线 + 星点（纯 CSS，零素材） */
.home__hero {
  position: relative;
  height: 250rpx;
  margin: 8rpx 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home__halo {
  position: absolute;
  border-radius: 50%;
  box-sizing: border-box;
}

.home__halo--outer {
  width: 236rpx;
  height: 236rpx;
  border: 1rpx solid rgba(217, 164, 65, 0.22);
}

.home__halo--inner {
  width: 178rpx;
  height: 178rpx;
  border: 1rpx solid rgba(194, 64, 47, 0.16);
}

/* 一弯月：gold 渐变实心圆 + paper 挖空圆成月牙 */
.home__moon {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #F0C468, #D9A441 58%, #C98A2E);
  box-shadow: 0 0 46rpx rgba(217, 164, 65, 0.5);
}

.home__moon::after {
  content: "";
  position: absolute;
  left: 32rpx;
  top: -16rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #FFF8F0;
}

/* 红线：斜贯主视觉的一道红绳 */
.home__thread {
  position: absolute;
  width: 300rpx;
  height: 3rpx;
  border-radius: 999rpx;
  transform: rotate(-16deg);
  background: linear-gradient(90deg, rgba(194, 64, 47, 0), rgba(194, 64, 47, 0.85), rgba(194, 64, 47, 0));
}

.home__star {
  position: absolute;
  border-radius: 50%;
  background: #D9A441;
}

.home__star--a {
  top: 34rpx;
  right: 96rpx;
  width: 8rpx;
  height: 8rpx;
  opacity: 0.85;
}

.home__star--b {
  bottom: 44rpx;
  left: 88rpx;
  width: 6rpx;
  height: 6rpx;
  opacity: 0.55;
}

.home__tagline {
  text-align: center;
  margin: 14rpx 0 22rpx;
}

/* 缘分 / 运气 / 相遇 */
.home__trio {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.home__tile {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(194, 64, 47, 0.16);
  background: linear-gradient(180deg, rgba(253, 241, 229, 0.92), rgba(255, 253, 250, 0.92));
}

.home__tile-label {
  margin-top: 12rpx;
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 24rpx;
  letter-spacing: 0.12em;
  color: #3A2B2E;
}

.home__tile-text {
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
  color: rgba(58, 43, 46, 0.6);
}

/* 三味符号（纯 CSS）：缘分 = 双环相扣 / 运气 = 旋转菱星 / 相遇 = 两点连线 */
.home__glyph {
  position: relative;
  width: 52rpx;
  height: 38rpx;
  box-sizing: border-box;
}

.home__glyph--fate::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 30rpx;
  height: 30rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 2rpx solid #C2402F;
}

.home__glyph--fate::after {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  width: 30rpx;
  height: 30rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 2rpx solid #D9A441;
}

.home__glyph--luck::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 3rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 6rpx;
  transform: rotate(45deg);
  background: linear-gradient(135deg, #F0C468, #C98A2E);
}

.home__glyph--luck::after {
  content: "";
  position: absolute;
  left: 19rpx;
  top: 9rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 3rpx;
  transform: rotate(45deg);
  background: #FFF8F0;
}

.home__glyph--meet {
  height: 30rpx;
  border-bottom: 2rpx solid rgba(194, 64, 47, 0.45);
}

.home__glyph--meet::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #C2402F;
}

.home__glyph--meet::after {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #D9A441;
}

.home__state {
  border-radius: 24rpx;
  border: 1rpx solid rgba(194, 64, 47, 0.28);
  background: #FDF1E5;
  padding: 18rpx 24rpx;
}

.home__state--pending,
.home__state--rejected {
  background: rgba(201, 138, 46, 0.1);
  border-color: rgba(201, 138, 46, 0.45);
  color: #8F6220;
}

.home__state--active {
  background: rgba(63, 122, 90, 0.09);
  border-color: rgba(63, 122, 90, 0.4);
  color: #31603F;
}

.home__state-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home__state-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.6;
}

.home__count {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 4rpx 28rpx;
}

.home__count-label {
  font-size: 23rpx;
  color: rgba(58, 43, 46, 0.62);
}

.home__count-num {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 30rpx;
  color: #A32E22;
}

.home__cta {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.home__btn {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 29rpx;
  border-radius: 999rpx;
}

.home__disclaimer {
  margin-top: 40rpx;
}

/* 取签浮层：选签筒 → 匹配中 → 池空/上限 → 展示缘签 */
.home__ov {
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.home__ov-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 32rpx 48rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFDFA;
  box-shadow: 0 -8rpx 40rpx rgba(58, 43, 46, 0.16);
}

.home__ov-title {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 34rpx;
  letter-spacing: 0.1em;
  text-align: center;
  color: #3A2B2E;
}

.home__pool {
  display: flex;
  gap: 24rpx;
  margin: 32rpx 0 24rpx;
}

.home__pool-btn {
  flex: 1;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  border-radius: 24rpx;
  border: 1rpx solid rgba(194, 64, 47, 0.32);
  background: linear-gradient(180deg, rgba(253, 241, 229, 0.92), rgba(255, 253, 250, 0.92));
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 34rpx;
  letter-spacing: 0.14em;
  color: #A32E22;
}

.home__ov-note {
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
  color: rgba(58, 43, 46, 0.6);
}

.home__ov-text {
  margin: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #3A2B2E;
}

.home__ov-count {
  margin: 24rpx 4rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: rgba(58, 43, 46, 0.62);
}

.home__ov-btn {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 27rpx;
  border-radius: 999rpx;
}

.home__ov-spin {
  width: 72rpx;
  height: 72rpx;
  margin: 56rpx auto 0;
  border-radius: 50%;
  border: 4rpx solid rgba(194, 64, 47, 0.18);
  border-top-color: #C2402F;
  animation: home-spin 0.9s linear infinite;
}

@keyframes home-spin {
  to {
    transform: rotate(360deg);
  }
}
