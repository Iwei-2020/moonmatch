/* P-03 我的档案 · Token 取自线稿说明 §一（色值冻结） */
.prof {
  min-height: 100vh;
}

.prof__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.prof__back,
.prof__corner {
  font-size: 24rpx;
  color: rgba(58, 43, 46, 0.62);
}

.prof__title {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 32rpx;
  letter-spacing: 0.1em;
  color: #3A2B2E;
}

.prof__card {
  background: #FDF1E5;
}

.prof__card--offline {
  background: #F4ECE4;
  border-style: dashed;
  border-color: rgba(185, 175, 166, 0.75);
}

.prof__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.prof__name {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 48rpx;
  color: #3A2B2E;
}

.prof__divider {
  height: 1rpx;
  background: rgba(194, 64, 47, 0.28);
  margin: 24rpx 0;
}

.prof__label {
  font-size: 23rpx;
  color: rgba(58, 43, 46, 0.62);
}

.prof__mask-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.prof__mask {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 36rpx;
  letter-spacing: 0.1em;
  color: #B9AFA6;
}

.prof__lock {
  font-size: 28rpx;
  color: #B9AFA6;
}

.prof__summary {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(217, 164, 65, 0.14);
  border: 1rpx solid rgba(217, 164, 65, 0.62);
  color: #8F6220;
  font-size: 23rpx;
  line-height: 1.6;
}

.prof__summary--active {
  background: rgba(63, 122, 90, 0.09);
  border-color: rgba(63, 122, 90, 0.4);
  color: #31603F;
}

.prof__summary--offline {
  background: rgba(185, 175, 166, 0.16);
  border-color: rgba(185, 175, 166, 0.65);
  color: #6E645D;
}

.prof__reject {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(201, 138, 46, 0.1);
  color: #A9631F;
  font-size: 23rpx;
  line-height: 1.6;
}

.prof__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.prof__act {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 27rpx;
  border-radius: 999rpx;
}

.prof__notice {
  margin-top: 22rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: rgba(58, 43, 46, 0.62);
}

.prof__disclaimer {
  margin-top: 40rpx;
}
