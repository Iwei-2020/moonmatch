<!-- P-03 我的档案 · 待审核 / 已留 / 已驳回 / 已下架 -->
<view class="mm-page prof">
  <view class="prof__hd">
    <view class="prof__back" >‹ 返回</view>
    <view class="prof__title">我的档案</view>
    <view class="prof__corner" bindtap="goReport">反馈</view>
  </view>

  <view class="mm-card prof__card prof__card--{{state}}">
    <view class="prof__head">
      <view class="prof__name">{{title}}</view>
      <audit-badge status="{{status}}" />
    </view>
    <view class="prof__divider"></view>
    <view class="prof__label">缘签（掩码）</view>
    <view class="prof__mask-row">
      <view class="mm-mask prof__mask">{{masked}}</view>
      <view class="prof__lock">🔒</view>
    </view>
  </view>

  <view tt:if="{{state === 'pending' || state === 'active' || state === 'offline'}}" class="prof__summary prof__summary--{{state}}">
    {{summary}}<block tt:if="{{state === 'active'}}"> · 今日被取 {{fetchedCount}} 次</block>
  </view>

  <view tt:if="{{state === 'rejected' && rejectReason}}" class="prof__reject">
    {{rejectedPrefix}}{{rejectReason}}
  </view>

  <view class="prof__actions">
    <button class="mm-btn mm-btn--primary prof__act" bindtap="onEdit">{{mainActionText}}</button>
    <button class="mm-btn mm-btn--ghost prof__act" bindtap="onToggleOffline">{{offlineActionText}}</button>
  </view>

  <view class="prof__notice">{{changeNotice}}，审核期间暂时离开匹配池</view>

  <view class="mm-disclaimer prof__disclaimer">{{disclaimer}}</view>
</view>
