/* P-02 留缘签 · 半屏表单容器（Token 取自线稿说明 §一，色值冻结） */
.reg {
  min-height: 100vh;
  position: relative;
}

.reg__backdrop {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(58, 43, 46, 0.44);
}

.reg__sheet {
  position: relative;
  margin-top: 200rpx;
  min-height: 80vh;
  border-radius: 48rpx 48rpx 0 0;
  background: #FFF8F0;
  padding: 44rpx 48rpx 60rpx;
}
