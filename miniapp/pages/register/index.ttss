/* P-02 登记 · Token 取自线稿说明 §一（色值冻结） */
.reg {
  min-height: 100vh;
  position: relative;
}

.reg__backdrop {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(58, 43, 46, 0.44);
}

.reg__sheet {
  position: relative;
  margin-top: 200rpx;
  min-height: 80vh;
  border-radius: 48rpx 48rpx 0 0;
  background: #FFF8F0;
  padding: 44rpx 48rpx 60rpx;
}

.reg__title {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 34rpx;
  letter-spacing: 0.08em;
  color: #3A2B2E;
}

.reg__hint {
  margin: 12rpx 0 32rpx;
}

.reg__label {
  margin: 28rpx 0 14rpx;
  font-size: 24rpx;
  color: rgba(58, 43, 46, 0.62);
}

.reg__pills {
  display: flex;
  gap: 20rpx;
}

.reg__pill {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(194, 64, 47, 0.55);
  color: #A32E22;
  font-size: 27rpx;
}

.reg__pill--on {
  background: #C2402F;
  border-color: #C2402F;
  color: #FFF8F0;
  font-weight: 600;
}

.reg__input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(194, 64, 47, 0.28);
  background: #FFFDFA;
  font-size: 27rpx;
  color: #3A2B2E;
}

.reg__seg {
  display: flex;
  height: 72rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(194, 64, 47, 0.28);
  overflow: hidden;
}

.reg__seg-item {
  flex: 1;
  line-height: 72rpx;
  text-align: center;
  font-size: 25rpx;
  color: rgba(58, 43, 46, 0.62);
  background: #FFFDFA;
}

.reg__seg-item--on {
  background: #FDF1E5;
  color: #A32E22;
  font-weight: 600;
}

.reg__masked {
  margin-top: 14rpx;
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 28rpx;
  letter-spacing: 0.1em;
  color: #B9AFA6;
}

.reg__tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(58, 43, 46, 0.62);
}

.reg__agree {
  margin-top: 32rpx;
}

.reg__agree-row {
  display: flex;
  align-items: center;
}

.reg__agree-text {
  font-size: 23rpx;
  line-height: 1.6;
  color: #3A2B2E;
  margin-left: 10rpx;
}

.reg__link {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #A32E22;
}

.reg__submit {
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 29rpx;
  border-radius: 999rpx;
}
