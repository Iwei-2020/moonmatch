/* P-04 取签结果卡 · Token 取自线稿说明 §一（色值冻结） */
.fetch {
  min-height: 100vh;
}

.fetch__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.fetch__back,
.fetch__entry {
  font-size: 24rpx;
  color: rgba(58, 43, 46, 0.62);
}

.fetch__entry {
  color: #A32E22;
}

.fetch__title {
  font-family: "Songti SC", "LXGW WenKai", serif;
  font-size: 32rpx;
  letter-spacing: 0.08em;
  color: #3A2B2E;
}

/* 主视觉：一弯月 */
.fetch__moon-wrap {
  display: flex;
  justify-content: center;
  margin: 60rpx 0 40rpx;
}

.fetch__moon-wrap--weak {
  opacity: 0.55;
}

.fetch__moon {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #D9A441;
  opacity: 0.85;
  position: relative;
  overflow: hidden;
}

.fetch__moon::after {
  content: "";
  position: absolute;
  left: 42rpx;
  top: -18rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #FFF8F0;
}

.fetch__main {
  height: 108rpx;
  line-height: 108rpx;
  font-size: 33rpx;
  border-radius: 999rpx;
  letter-spacing: 0.06em;
}

.fetch__count {
  margin-top: 28rpx;
  text-align: center;
  font-size: 23rpx;
  color: rgba(58, 43, 46, 0.62);
}

.fetch__note {
  margin-top: 12rpx;
  text-align: center;
}

.fetch__spin {
  width: 56rpx;
  height: 56rpx;
  margin: 60rpx auto 24rpx;
  border: 4rpx solid rgba(194, 64, 47, 0.2);
  border-top-color: #C2402F;
  border-radius: 50%;
  animation: fetch-rotate 1s linear infinite;
}

@keyframes fetch-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.fetch__matching {
  text-align: center;
  font-size: 27rpx;
  color: #3A2B2E;
  margin-bottom: 36rpx;
}

.fetch__skeleton {
  height: 32rpx;
  border-radius: 16rpx;
  background: #F4ECE4;
  margin: 18rpx 0;
}

.fetch__empty {
  text-align: center;
  font-size: 27rpx;
  line-height: 1.8;
  color: #3A2B2E;
  margin-bottom: 40rpx;
}

.fetch__limit {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(201, 138, 46, 0.12);
  color: #A9631F;
  font-size: 24rpx;
  text-align: center;
}

.fetch__foot {
  margin-top: 32rpx;
}

.fetch__actions {
  display: flex;
  gap: 20rpx;
}

.fetch__again {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 27rpx;
  border-radius: 999rpx;
}

.fetch__disclaimer {
  margin-top: 40rpx;
}
