<!-- P-04 取签结果卡 · IDLE / MATCHING / EMPTY / LOCKED / UNLOCKED / DEAD / LIMIT -->
<view class="mm-page fetch">
  <view class="fetch__hd">
    <view class="fetch__back" bindtap="goHome">‹ 返回</view>
    <view class="fetch__title">{{title}}</view>
    <view class="fetch__entry" bindtap="goUnlocks">{{unlocksEntry}}</view>
  </view>

  <!-- ① 待匹配 IDLE -->
  <block tt:if="{{state === 'idle'}}">
    <view class="fetch__moon-wrap">
      <view class="fetch__moon"></view>
    </view>
    <button
      class="mm-btn {{fetchDisabled ? 'mm-btn--disabled' : 'mm-btn--primary'}} fetch__main"
      bindtap="onTapFetch"
    >{{fetchBtnText}}</button>
    <view class="fetch__count">今日剩余缘签 {{remain}} 个</view>
    <view class="mm-sub fetch__note">{{poolNote}}</view>
  </block>

  <!-- ② 匹配中 MATCHING -->
  <block tt:elif="{{state === 'matching'}}">
    <view class="fetch__spin"></view>
    <view class="fetch__matching">{{matchingText}}</view>
    <view class="fetch__skeleton"></view>
    <view class="fetch__skeleton"></view>
    <view class="fetch__skeleton"></view>
    <view class="mm-sub fetch__note">通常 500ms 内出卡</view>
  </block>

  <!-- ③ 池子空 EMPTY -->
  <block tt:elif="{{state === 'empty'}}">
    <view class="fetch__moon-wrap fetch__moon-wrap--weak">
      <view class="fetch__moon"></view>
    </view>
    <view class="fetch__empty">{{emptyText}}</view>
    <button class="mm-btn mm-btn--ghost fetch__main" bindtap="goHome">返回首页</button>
    <view class="mm-sub fetch__note">池子 24:00 自然日重置</view>
  </block>

  <!-- ⑦ 达每日上限 LIMIT（无卡片） -->
  <block tt:elif="{{state === 'limit'}}">
    <view class="fetch__moon-wrap fetch__moon-wrap--weak">
      <view class="fetch__moon"></view>
    </view>
    <view class="fetch__empty">{{limitText}}</view>
    <button class="mm-btn mm-btn--disabled fetch__main" disabled>{{fetchBtnText}}</button>
    <view class="mm-sub fetch__note">每日 {{dailyLimit}} 次，24:00 自然日重置（以服务端记账为准）</view>
  </block>

  <!-- ④⑤⑥ 锁定 / 已解签 / 已失效 -->
  <block tt:else>
    <match-card
      card="{{card}}"
      mode="{{cardMode}}"
      bind:unlock="onUnlock"
      bind:report="onCardReport"
    />

    <view tt:if="{{fetchDisabled}}" class="fetch__limit">{{limitText}}</view>

    <view class="fetch__foot">
      <view class="fetch__actions">
        <button
          tt:if="{{!fetchDisabled}}"
          class="mm-btn mm-btn--ghost fetch__again"
          bindtap="onTapFetch"
        >{{fetchBtnText}}</button>
      </view>
    </view>

    <view class="fetch__count">今日剩余缘签 {{remain}} 个</view>
  </block>

  <view class="mm-disclaimer fetch__disclaimer">{{disclaimer}}</view>
</view>

<unlock-popup
  visible="{{popupVisible}}"
  state="{{popupState}}"
  failureText="{{popupFailure}}"
  bind:confirm="onPopupConfirm"
  bind:retry="onPopupRetry"
  bind:close="onPopupClose"
/>
